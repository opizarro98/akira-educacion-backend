# Copiar a .env (no versionado) y ajustar los valores.
# Spring no lee .env automáticamente: exportar las variables antes de arrancar.

# --- Base de datos PostgreSQL local ---
DB_URL=jdbc:postgresql://localhost:5432/akira_educacion
DB_USER=akira_app
DB_PASSWORD=cambiar_en_local
DB_SCHEMA=akira_dev
DB_POOL_SIZE=5

# --- JWT (HS256 exige al menos 32 bytes) ---
JWT_SECRET=45f65085e8388e995a3ef683d39176f971dad7f4e00fe5679514dd86273c9084
JWT_ISSUER=akira-educacion
JWT_TTL=PT1H

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Datos de arranque (solo perfil dev) ---
APP_SEED_ENABLED=true
APP_SEED_DEMO=true
APP_SEED_ADMIN_EMAIL=admin@akira.local
APP_SEED_ADMIN_PASSWORD=cambiar_en_local
APP_SEED_DEMO_INSTITUTION=Institución Demo
APP_SEED_DEMO_EMAIL=admin@demo.local
APP_SEED_DEMO_PASSWORD=cambiar_en_local

# --- Servidor ---
SERVER_PORT=8080
